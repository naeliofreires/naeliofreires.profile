---
import type { SupportedLocale } from '../i18n/utils';
import { locales, defaultLocale, getLocalizedPath } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'pt';
  ogImage?: string;
}

const { title, description, lang, ogImage = 'https://www.naeliofreires.dev/og-banner.png' } = Astro.props;
const siteUrl = 'https://www.naeliofreires.dev';

const localeMap: Record<SupportedLocale, string> = {
  en: 'en_US',
  pt: 'pt_BR',
};

const currentPath = Astro.url.pathname;
const pathWithoutLocale =
  currentPath.startsWith(`/${lang}/`) || currentPath.startsWith(`/${lang}`)
    ? currentPath.replace(new RegExp(`^/${lang}(?=/|$)`), '') || '/'
    : currentPath;

const canonicalUrl = new URL(currentPath, siteUrl).href;

const alternateLinks = locales.map((locale) => ({
  hreflang: locale,
  href: new URL(getLocalizedPath(pathWithoutLocale, locale), siteUrl).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="400x400" href="/favicon-400.png" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Naelio Freires" />
    <meta property="og:locale" content={localeMap[lang]} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- hreflang alternates -->
    {alternateLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(pathWithoutLocale, defaultLocale), siteUrl).href} />

    <!-- JSON-LD Person Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Naelio Freires",
      "jobTitle": "Front-End Developer",
      "url": siteUrl,
      "sameAs": [
        "https://github.com/naeliofreires",
        "https://linkedin.com/in/naeliofreires",
      ],
    })} />

    <!-- Vercel Web Analytics -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
