---
import type { SupportedLocale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import StackMarquee from '../../components/StackMarquee.astro';
import Expertise from '../../components/Expertise.astro';
import Trajectory from '../../components/Trajectory.astro';
import Projects from '../../components/Projects.astro';
import Footer from '../../components/Footer.astro';
import Timeline from '../../components/react/Timeline';

const lang: SupportedLocale = 'en';
---

<BaseLayout
  title={t(lang, 'meta.title')}
  description={t(lang, 'meta.description')}
  lang={lang}
>
  <body class="bg-base text-brand-ink min-h-screen w-full flex flex-col items-center relative selection:bg-brand-lime selection:text-brand-ink">
    <Navbar lang={lang} />
    <main class="w-full z-10 flex flex-col items-center justify-center min-h-[88vh] px-4 sm:px-16 md:px-24 py-16 md:py-24" id="about">
      <Hero lang={lang} />
    </main>
    <StackMarquee lang={lang} />
    <Expertise lang={lang} />
    <Trajectory lang={lang} />
    <Projects lang={lang} />
    <Footer lang={lang} />
    <Timeline client:idle />
  </body>
</BaseLayout>
