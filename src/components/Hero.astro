---
import { t } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
---

<div class="w-full max-w-6xl mx-auto flex flex-col items-center justify-center gap-6 md:gap-8 text-center">
  <!-- Availability Badge -->
  <div class="flex items-center gap-3 opacity-0 animate-fade-in animate-delay-100">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-lime opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-lime border border-brand-ink/40"></span>
    </span>
    <span class="text-xs font-mono font-medium tracking-[0.2em] text-brand-ink uppercase">
      {t(lang, 'hero.availableBadge')}
    </span>
  </div>

  <!-- Main Heading -->
  <div class="opacity-0 animate-fade-in animate-delay-200">
    <h1 class="text-4xl sm:text-6xl md:text-7xl leading-[1.05] tracking-[-0.02em] font-bold font-everett uppercase text-brand-ink break-words hyphens-auto">
      {t(lang, 'hero.nameLine1')}
      <br />
      {t(lang, 'hero.nameLine2')}
    </h1>
    <p class="mt-6 md:mt-8 text-base md:text-lg font-neue font-light text-brand-ink/80 max-w-2xl mx-auto leading-[1.5] px-2">
      {t(lang, 'hero.intro')}
    </p>
  </div>

  <!-- Actions -->
  <div class="flex flex-wrap items-center justify-center gap-4 opacity-0 animate-fade-in animate-delay-300">
    <a
      class="group flex items-center gap-2 rounded-[3px] bg-brand-ink text-base px-6 py-3 font-bold font-neue text-base transition-all duration-300 hover:opacity-85"
      href="#work"
    >
      <span>{t(lang, 'hero.viewPortfolio')}</span>
      <svg aria-hidden="true" class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <path d="M12 5v14"></path>
        <path d="m19 12-7 7-7-7"></path>
      </svg>
    </a>
    <a
      class="flex items-center gap-2 rounded-[3px] border-[1.5px] border-brand-ink bg-brand-lime px-6 py-3 font-bold font-neue text-brand-ink transition-all duration-300 hover:bg-brand-lime-hover"
      href="mailto:naeliofreires@gmail.com"
    >
      {t(lang, 'nav.contact')}
    </a>
  </div>

  <!-- Social Links -->
  <div class="flex items-center justify-center gap-2 opacity-0 animate-fade-in animate-delay-300">
    <a class="flex items-center justify-center w-10 h-10 border border-brand-ink text-brand-ink hover:bg-base-hover transition-colors rounded-[3px]" href="https://github.com/naeliofreires" target="_blank" rel="noreferrer" aria-label="GitHub">
      <svg class="w-5 h-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
        <path d="M9 18c-4.51 2-5-2-7-2"></path>
      </svg>
    </a>
    <a class="flex items-center justify-center w-10 h-10 border border-brand-ink text-brand-ink hover:bg-base-hover transition-colors rounded-[3px]" href="https://www.linkedin.com/in/naeliofreires" target="_blank" rel="noreferrer" aria-label="LinkedIn">
      <svg class="w-5 h-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect width="4" height="12" x="2" y="9"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
    </a>
    <a class="flex items-center justify-center w-10 h-10 border border-brand-ink text-brand-ink hover:bg-base-hover transition-colors rounded-[3px]" href="mailto:naeliofreires@gmail.com" aria-label="Email">
      <svg class="w-5 h-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
    </a>
    <a class="flex items-center justify-center w-10 h-10 border border-brand-ink text-brand-ink hover:bg-base-hover transition-colors rounded-[3px]" href="/assets/naelio-freires-resume.pdf" download="Naelio-Freires-Resume.pdf" aria-label={t(lang, 'hero.downloadResumeAria')}>
      <svg class="w-5 h-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" x2="12" y1="15" y2="3"></line>
      </svg>
    </a>
    <a class="flex items-center justify-center w-10 h-10 border border-brand-ink text-brand-ink hover:bg-base-hover transition-colors rounded-[3px]" href="https://wa.me/5585984588353" target="_blank" rel="noreferrer" aria-label={t(lang, 'hero.whatsappAria')}>
      <svg class="w-5 h-5" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24">
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
      </svg>
    </a>
  </div>

  <!-- Core Stack -->
  <div class="flex flex-wrap items-center justify-center gap-2 opacity-0 animate-fade-in animate-delay-300 mt-2">
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">React</span>
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">React Native</span>
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">TypeScript</span>
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">Node.js</span>
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">NestJS</span>
    <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">FastAPI</span>
  </div>
</div>
