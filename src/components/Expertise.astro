---
import { t } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;

const cards = [
  {
    key: 'architecture',
    bg: 'bg-white',
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    key: 'mobile',
    bg: 'bg-periwinkle',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    key: 'quality',
    bg: 'bg-sand',
    icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  },
  {
    key: 'bots',
    bg: 'bg-sage',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
] as const;
---

<section class="w-full text-brand-ink" id="expertise">
  <div class="flex flex-col border-t border-brand-ink border-dashed">
    <div class="relative border-r border-l border-brand-ink border-dashed w-full max-w-6xl mx-auto py-10 md:py-16">
      <div class="flex flex-col gap-2 text-center w-full px-4 sm:px-16 md:px-24">
        <div class="mx-auto font-mono text-xs font-medium mb-4 text-center text-brand-ink">
          // {t(lang, 'expertise.eyebrow')}
        </div>
        <h2 class="text-4xl md:text-5xl font-bold font-everett uppercase tracking-[-0.02em] leading-[1.2] text-center">
          {t(lang, 'expertise.heading')}
        </h2>
        <p class="text-base md:text-lg text-center max-w-4xl mx-auto font-neue font-light leading-[1.4]">
          {t(lang, 'expertise.subheading')}
        </p>
      </div>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-16 md:px-24 py-10 md:py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cards.map((card) => (
        <div class:list={['border border-brand-ink p-6 flex flex-col gap-4 transition-colors duration-300 hover:bg-base-hover', card.bg]}>
          <div class="w-12 h-12 border border-brand-ink bg-white flex items-center justify-center text-brand-ink">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold font-everett uppercase tracking-[-0.02em] leading-[1.3] text-brand-ink mb-3">
              {t(lang, `expertise.items.${card.key}.title`)}
            </h3>
            <p class="text-sm font-neue font-light text-brand-ink/80 leading-[1.5]">
              {t(lang, `expertise.items.${card.key}.desc`)}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
