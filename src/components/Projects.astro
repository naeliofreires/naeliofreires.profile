---
import { t } from '../i18n/utils';
import type { SupportedLocale } from '../i18n/utils';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;

const projects = [
  {
    key: 'nexlaChatbot',
    bg: 'bg-brand-lavender',
    label: 'AI Chatbot',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    tags: ['React', 'AI', 'E2E'],
    link: 'https://linkedin.com/in/naeliofreires',
  },
  {
    key: 'esportudo',
    bg: 'bg-periwinkle',
    label: 'Sports',
    icon: null,
    tags: ['React', 'Next.js', 'Redux'],
    link: 'https://linkedin.com/in/naeliofreires',
  },
  {
    key: 'ionicMigration',
    bg: 'bg-sand',
    label: 'Migration',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    tags: ['React Native', 'Migration'],
    link: null,
  },
  {
    key: 'heavyconnect',
    bg: 'bg-sage',
    label: 'Offline-first',
    icon: 'M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3',
    tags: ['React Native', 'Offline'],
    link: 'https://linkedin.com/in/naeliofreires',
  },
] as const;
---

<section class="w-full max-w-7xl mx-auto px-4 sm:px-16 md:px-24 py-16 md:py-24 text-brand-ink border-t border-brand-ink/20" id="work">
  <!-- Heading -->
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10 md:mb-14">
    <div>
      <p class="font-mono text-xs font-semibold uppercase mb-3">// {t(lang, 'work.eyebrow')}</p>
      <h2 class="text-4xl md:text-5xl font-bold font-everett uppercase tracking-[-0.02em] leading-[1.2] mb-4">
        {t(lang, 'work.heading')}
      </h2>
      <p class="text-base md:text-lg font-neue font-light text-brand-ink/80 max-w-2xl">{t(lang, 'work.subheading')}</p>
    </div>
    <a
      href="https://github.com/naeliofreires"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 border border-brand-ink px-4 py-2 font-mono text-sm font-medium uppercase rounded-[3px] hover:bg-base-hover transition-colors shrink-0 w-fit"
    >
      {t(lang, 'work.viewGitHub')}
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
    </a>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {projects.map((project) => {
      const Card = project.link ? 'a' : 'div';
      return (
        <Card
          class:list={[
            'group flex flex-col border border-brand-ink bg-base overflow-hidden transition-colors duration-300',
            project.link ? 'hover:bg-base-soft' : '',
          ]}
          href={project.link ?? undefined}
          target={project.link ? '_blank' : undefined}
          rel={project.link ? 'noopener noreferrer' : undefined}
          aria-label={project.link ? t(lang, `work.projects.${project.key}.ariaLabel`) : undefined}
        >
          <!-- Visual Area -->
          <div class:list={['relative aspect-[4/3] border-b border-brand-ink flex items-center justify-center overflow-hidden', project.bg]}>
            <div class="text-center px-6">
              {project.icon ? (
                <svg class="w-12 h-12 text-brand-ink/40 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={project.icon} /></svg>
              ) : (
                <span class="text-brand-ink/60 text-5xl font-everett font-bold uppercase tracking-tighter">{project.label}</span>
              )}
            </div>
            <div class="absolute top-3 left-3 border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">
              ({project.label})
            </div>
          </div>
          <!-- Info Area -->
          <div class="p-5 md:p-6 flex flex-col flex-1">
            <h3 class="text-lg md:text-xl font-bold font-everett uppercase tracking-[-0.02em] leading-[1.3] text-brand-ink mb-2">
              {t(lang, `work.projects.${project.key}.title`)}
            </h3>
            <p class="text-sm font-neue font-light text-brand-ink/80 mb-4">{t(lang, `work.projects.${project.key}.desc`)}</p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {project.tags.map((tag) => (
                <span class="border border-brand-ink bg-white text-brand-ink text-[10.5px] font-mono font-semibold uppercase rounded-sm px-1.5 py-[3px]">{tag}</span>
              ))}
            </div>
          </div>
        </Card>
      );
    })}
  </div>
</section>
